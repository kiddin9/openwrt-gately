#!/bin/sh /etc/rc.common
# Gately OpenWrt procd init script

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/gately

start_service() {
	config_load gately

	local enabled configdir applydir initial_password
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get configdir main configdir '/etc/gately'
	config_get applydir main applydir ''
	config_get initial_password main initial_password 'admin123456'

	mkdir -p "$configdir"
	chmod 700 "$configdir"

	procd_open_instance gately
	procd_set_param command "$PROG" -c "$configdir"
	[ -n "$applydir" ] && procd_append_param command -apply "$applydir"
	[ -n "$initial_password" ] && procd_set_param env GATELY_INITIAL_PASSWORD="$initial_password"

	# 进程异常退出后自动拉起：阈值 3600 秒内最多 5 次，间隔 5 秒
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="65535 65535"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/gately "$configdir/gately.json"
	procd_close_instance
}

stop_service() {
	rm -f /tmp/gately_info_cache 2>/dev/null
}

reload_service() {
	stop
	sleep 1
	start
}

service_triggers() {
	procd_add_reload_trigger "gately"
}
